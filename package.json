{
  "name": "cosine-astro-mcp",
  "version": "0.1.0",
  "description": "Western astrology MCP server: natal charts, transits, synastry, Mercury retrograde, annual profections and moon phases, computed offline with astronomy-engine. By COSINE (cosineastro.com).",
  "license": "MIT",
  "author": "COSINE (https://www.cosineastro.com)",
  "homepage": "https://www.cosineastro.com",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "astrology",
    "natal-chart",
    "birth-chart",
    "horoscope",
    "transits",
    "synastry",
    "mercury-retrograde",
    "profection",
    "ephemeris",
    "placidus"
  ],
  "type": "module",
  "bin": {
    "cosine-astro-mcp": "dist/index.js"
  },
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/chmod-bin.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js",
    "smoke": "node scripts/smoke.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.0",
    "astronomy-engine": "2.1.19",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
